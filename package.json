{
  "name": "fyro-print-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/print-agent-desktop.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "dist:win": "pnpm run build && electron-builder --config electron-builder.config.cjs --win"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@types/node": "25.3.3",
    "electron": "41.10.7",
    "electron-builder": "26.15.3",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": ">=7.0.5",
      "lodash": ">=4.18.0",
      "js-yaml": ">=4.2.0"
    }
  }
}
